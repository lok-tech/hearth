{
  "name": "@lok-tech/hearth",
  "version": "0.3.0",
  "description": "Static and SSR pages from one template location, baked to files for static-speed serving.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lok-tech/hearth.git",
    "directory": "npm/hearth"
  },
  "homepage": "https://github.com/lok-tech/hearth#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "hearth": "bin/hearth.js"
  },
  "exports": {
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "vite.js",
    "vite.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "sharp": ">=0.33",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@lok-tech/cli-darwin-arm64": "0.3.0",
    "@lok-tech/cli-darwin-x64": "0.3.0",
    "@lok-tech/cli-linux-arm64": "0.3.0",
    "@lok-tech/cli-linux-x64": "0.3.0",
    "@lok-tech/cli-win32-arm64": "0.3.0",
    "@lok-tech/cli-win32-x64": "0.3.0"
  },
  "devDependencies": {
    "vite": "^6.4.6"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
